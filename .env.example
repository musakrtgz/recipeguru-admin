# Geliştirme: .env olarak kopyalayın. Güçlü, benzersiz en az 32 karakter anahtar üretin.
NUXT_SESSION_PASSWORD=
NUXT_SITE_URL=http://localhost:3000
NUXT_API_ENVIRONMENT=development
NUXT_PUBLIC_ENVIRONMENT=development
NUXT_API_BASE_DEV=https://recipev3.test/api
NUXT_API_BASE_PROD=https://api.recipeguru.app/api
